<Application x:Class="PanelTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PanelTracker.App.Converters"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <conv:HexToBrushConverter x:Key="HexToBrush" />
    <conv:ContrastForegroundConverter x:Key="ContrastForeground" />
    <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:PositiveToVisibilityConverter x:Key="DuplicateVisibility" />
    <conv:RoleNameConverter x:Key="RoleName" />

    <Style TargetType="Button" x:Key="ToolbarButton">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Muted">
      <Setter Property="Foreground" Value="#666" />
    </Style>
  </Application.Resources>
</Application>
