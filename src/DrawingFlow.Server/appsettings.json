{
  "ConnectionStrings": {
    "DrawingFlow": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "DrawingFlow",
    "Audience": "DrawingFlow.Clients",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 30
  },
  "Bootstrap": {
    "Administrator": {
      "Login": "",
      "Password": "",
      "DisplayName": "Администратор сервера",
      "MustChangePassword": true
    }
  },
  "RateLimits": {
    "LoginPerMinute": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "RootPath": "",
    "MaxFileSizeBytes": 1073741824
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
