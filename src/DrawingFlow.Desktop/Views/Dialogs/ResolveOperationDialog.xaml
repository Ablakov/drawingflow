<UserControl x:Class="DrawingFlow.Desktop.Views.Dialogs.ResolveOperationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dvm="clr-namespace:DrawingFlow.Desktop.ViewModels.Dialogs"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=dvm:ResolveOperationDialogViewModel}">
  <StackPanel>
    <TextBlock Text="Файл" Style="{StaticResource Text.FieldLabel}" />
    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" Visibility="{Binding Error, Converter={StaticResource NotNullToVisibility}}" />
    <TextBlock Text="Поиск документа в проекте" Style="{StaticResource Text.FieldLabel}" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Найти" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Номер или наименование документа">
        <TextBox.InputBindings>
          <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
        </TextBox.InputBindings>
      </TextBox>
    </DockPanel>
    <TextBlock Text="Документ" Style="{StaticResource Text.FieldLabel}" />
    <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedDocument}" MinHeight="120" MaxHeight="240" />
    <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0"
               Text="Файл будет загружен как новая версия выбранного документа при следующем сеансе связи агента с сервером." />
  </StackPanel>
</UserControl>
