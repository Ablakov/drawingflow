<UserControl x:Class="DrawingFlow.Desktop.Views.Dialogs.RegisterAgentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dvm="clr-namespace:DrawingFlow.Desktop.ViewModels.Dialogs"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=dvm:RegisterAgentDialogViewModel}">
  <StackPanel>
    <TextBlock Text="Название агента" Style="{StaticResource Text.FieldLabel}" />
    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например: рабочая станция Иванова, сервер проектного отдела" />
    <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0"
               Text="После регистрации будет показан ключ установки. Он отображается один раз; укажите его при установке службы агента на рабочей станции." />
  </StackPanel>
</UserControl>
