<UserControl x:Class="DrawingFlow.Desktop.Views.Dialogs.AgentKeyDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dvm="clr-namespace:DrawingFlow.Desktop.ViewModels.Dialogs"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=dvm:AgentKeyDialogViewModel}">
  <StackPanel>
    <Border Style="{StaticResource Border.InfoBanner}">
      <TextBlock Style="{StaticResource Text.Base}">
        <Run Text="Агент" /><Run Text=" «" /><Run Text="{Binding AgentName, Mode=OneWay}" /><Run Text="» зарегистрирован. Ключ показывается только сейчас — сохраните его в надёжном месте." />
      </TextBlock>
    </Border>
    <TextBlock Text="Ключ агента" Style="{StaticResource Text.FieldLabel}" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Копировать" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding CopyKeyCommand}" />
      <TextBox Text="{Binding AgentKey, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" />
    </DockPanel>
    <TextBlock Text="Команда установки на рабочей станции" Style="{StaticResource Text.FieldLabel}" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Копировать" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding CopyCommandCommand}" />
      <TextBox Text="{Binding RegisterCommandLine, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" />
    </DockPanel>
    <TextBlock Text="{Binding CopyStatus}" Style="{StaticResource Text.Small}" Margin="0,8,0,0" Foreground="{StaticResource Brush.Success}" />
  </StackPanel>
</UserControl>
