<UserControl x:Class="DrawingFlow.Desktop.Views.Dialogs.ReviewDecisionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dvm="clr-namespace:DrawingFlow.Desktop.ViewModels.Dialogs"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=dvm:ReviewDecisionDialogViewModel}">
  <StackPanel>
    <TextBlock Text="Документ" Style="{StaticResource Text.FieldLabel}" />
    <TextBlock Text="{Binding DocumentLabel}" FontWeight="SemiBold" />
    <TextBlock Text="{Binding CommentLabel}" Style="{StaticResource Text.FieldLabel}" />
    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto" />
    <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0" Visibility="{Binding IsRevision, Converter={StaticResource BoolToVisibility}}"
               Text="Автору версии будет поставлена задача на доработку с вашими замечаниями. После загрузки новой версии согласование начнётся заново." />
  </StackPanel>
</UserControl>
