<UserControl x:Class="DrawingFlow.Desktop.Views.Dialogs.CreateUserDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:DrawingFlow.Desktop.Behaviors"
             xmlns:dvm="clr-namespace:DrawingFlow.Desktop.ViewModels.Dialogs"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=dvm:CreateUserDialogViewModel}">
  <StackPanel>
    <TextBlock Text="Логин" Style="{StaticResource Text.FieldLabel}" />
    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" ToolTip="Латинские буквы, цифры и символы . _ @ -" />
    <TextBlock Text="Имя (отображаемое)" Style="{StaticResource Text.FieldLabel}" />
    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Text="Электронная почта (необязательно)" Style="{StaticResource Text.FieldLabel}" />
    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Text="Временный пароль" Style="{StaticResource Text.FieldLabel}" />
    <PasswordBox b:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Text="Повторите пароль" Style="{StaticResource Text.FieldLabel}" />
    <PasswordBox b:PasswordBoxHelper.BoundPassword="{Binding PasswordConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Visibility="{Binding HasOrganization, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Роль в организации" Style="{StaticResource Text.FieldLabel}" />
      <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name" />
    </StackPanel>
    <CheckBox Content="Требовать смену пароля при первом входе" IsChecked="{Binding RequirePasswordChange}" Margin="0,12,0,0" />
    <CheckBox Content="Администратор сервера" IsChecked="{Binding IsServerAdministrator}" Margin="0,8,0,0"
              Visibility="{Binding AllowServerAdministrator, Converter={StaticResource BoolToVisibility}}" />
    <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0"
               Text="Сообщите пользователю временный пароль лично. Рекомендуется сменить его после первого входа." />
  </StackPanel>
</UserControl>
