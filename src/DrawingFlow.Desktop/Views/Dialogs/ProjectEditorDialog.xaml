<UserControl x:Class="DrawingFlow.Desktop.Views.Dialogs.ProjectEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dvm="clr-namespace:DrawingFlow.Desktop.ViewModels.Dialogs"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=dvm:ProjectEditorDialogViewModel}">
  <StackPanel>
    <TextBlock Text="Код проекта" Style="{StaticResource Text.FieldLabel}" />
    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCreate}"
             ToolTip="Латинские буквы, цифры, точка, подчёркивание, дефис. После создания код не меняется." />
    <TextBlock Text="Название" Style="{StaticResource Text.FieldLabel}" />
    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Text="Описание" Style="{StaticResource Text.FieldLabel}" />
    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto" />
    <StackPanel Visibility="{Binding IsEdit, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Статус" Style="{StaticResource Text.FieldLabel}" />
      <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Name" />
    </StackPanel>
  </StackPanel>
</UserControl>
