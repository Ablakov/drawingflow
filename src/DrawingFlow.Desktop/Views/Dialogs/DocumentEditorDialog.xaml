<UserControl x:Class="DrawingFlow.Desktop.Views.Dialogs.DocumentEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dvm="clr-namespace:DrawingFlow.Desktop.ViewModels.Dialogs"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=dvm:DocumentEditorDialogViewModel}">
  <StackPanel>
    <TextBlock Text="Номер (шифр) документа" Style="{StaticResource Text.FieldLabel}" />
    <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCreate}"
             ToolTip="Например: АР-01.2-КЖ. Уникален в пределах проекта; после регистрации не меняется." />
    <TextBlock Text="Наименование" Style="{StaticResource Text.FieldLabel}" />
    <TextBox Text="{Binding DocumentTitle, UpdateSourceTrigger=PropertyChanged}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="Раздел (дисциплина)" Style="{StaticResource Text.FieldLabel}" />
        <TextBox Text="{Binding Discipline, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например: АР, КЖ, ЭОМ" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Тип документа" Style="{StaticResource Text.FieldLabel}" />
        <TextBox Text="{Binding DocumentType, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например: чертёж, спецификация, пояснительная записка" />
      </StackPanel>
    </Grid>
    <TextBlock Text="Описание" Style="{StaticResource Text.FieldLabel}" />
    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalScrollBarVisibility="Auto" />
  </StackPanel>
</UserControl>
