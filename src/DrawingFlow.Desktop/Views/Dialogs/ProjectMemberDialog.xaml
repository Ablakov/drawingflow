<UserControl x:Class="DrawingFlow.Desktop.Views.Dialogs.ProjectMemberDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dvm="clr-namespace:DrawingFlow.Desktop.ViewModels.Dialogs"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=dvm:ProjectMemberDialogViewModel}">
  <StackPanel>
    <StackPanel Visibility="{Binding IsCreate, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Участник организации" Style="{StaticResource Text.FieldLabel}" />
      <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock>
              <Run Text="{Binding DisplayName, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding Login, Mode=OneWay}" /><Run Text=")" />
            </TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>
    <StackPanel Visibility="{Binding IsEdit, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Участник" Style="{StaticResource Text.FieldLabel}" />
      <TextBlock Text="{Binding MemberDisplayName}" FontWeight="SemiBold" />
    </StackPanel>
    <TextBlock Text="Роль в проекте" Style="{StaticResource Text.FieldLabel}" />
    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name" />
  </StackPanel>
</UserControl>
