<Window x:Class="DrawingFlow.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DrawingFlow.Desktop.ViewModels"
        mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="DrawingFlow" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI" FontSize="13">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Навигация -->
    <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource Brush.NavBackground}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,20,20,12">
          <TextBlock Text="DrawingFlow" FontSize="20" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="Документооборот" FontSize="12" Foreground="{StaticResource Brush.NavText}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="20,0,20,8" Visibility="{Binding HasOrganizations, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Организация" FontSize="11" Foreground="{StaticResource Brush.NavText}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Organizations}" SelectedItem="{Binding SelectedOrganization}" DisplayMemberPath="Name" />
          <TextBlock Text="{Binding OrganizationRoleName}" FontSize="11" Foreground="{StaticResource Brush.NavText}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="20,12,20,16">
          <TextBlock Text="{Binding UserDisplayName}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding CurrentUser.Login}" FontSize="12" Foreground="{StaticResource Brush.NavText}" />
          <Button Content="Выйти" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="-6,6,0,0"
                  Foreground="{StaticResource Brush.NavText}" Command="{Binding LogoutCommand}" />
        </StackPanel>

        <ListBox Style="{StaticResource Nav.ListBox}" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}" Margin="0,8">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Содержимое -->
    <Grid Grid.Column="1" Grid.Row="0">
      <ContentControl Content="{Binding CurrentPage}" Margin="28,24,28,16" />
      <Border Style="{StaticResource Border.Card}" Margin="28,24" VerticalAlignment="Top"
              Visibility="{Binding HasOrganizations, Converter={StaticResource InverseBoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="Нет доступных организаций" Style="{StaticResource Text.SectionTitle}" />
          <TextBlock Style="{StaticResource Text.Muted}"
                     Text="Ваша учётная запись не состоит ни в одной организации. Обратитесь к администратору, чтобы вас добавили в организацию и проекты." />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Строка состояния -->
    <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,6">
      <DockPanel>
        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Connection.IsOnline}" Value="False">
                  <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding Connection.StatusText}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Text.Small}" VerticalAlignment="Center">
          <Run Text="Сервер:" /><Run Text=" " /><Run Text="{Binding ServerAddress, Mode=OneWay}" />
        </TextBlock>
      </DockPanel>
    </Border>
  </Grid>
</Window>
