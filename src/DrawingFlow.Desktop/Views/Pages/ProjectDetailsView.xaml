<UserControl x:Class="DrawingFlow.Desktop.Views.Pages.ProjectDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrawingFlow.Desktop.ViewModels"
             xmlns:b="clr-namespace:DrawingFlow.Desktop.Behaviors"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ProjectDetailsViewModel}">
  <UserControl.Resources>
    <b:BindingProxy x:Key="Proxy" Data="{Binding}" />
  </UserControl.Resources>
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="Документы проекта" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" Command="{Binding OpenDocumentsCommand}" />
        <Button Content="Изменить" Style="{StaticResource Button.Secondary}" Command="{Binding EditCommand}"
                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="Обновить" Style="{StaticResource Button.Link}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
      </StackPanel>
      <StackPanel>
        <Button Content="← К списку проектов" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="-6,0,0,4" Command="{Binding BackCommand}" />
        <TextBlock Style="{StaticResource Text.PageTitle}" Margin="0">
          <Run Text="{Binding Project.Code, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding Project.Name, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </DockPanel>

    <ProgressBar DockPanel.Dock="Top" Style="{StaticResource ProgressBar.Thin}" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    <Border DockPanel.Dock="Top" Style="{StaticResource Border.ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Повторить" Style="{StaticResource Button.Link}" Command="{Binding RefreshCommand}" />
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource Border.Card}" Margin="0,0,0,12" Visibility="{Binding Project, Converter={StaticResource NotNullToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Статус" Style="{StaticResource Text.Small}" />
          <TextBlock Text="{Binding StatusName}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Моя роль" Style="{StaticResource Text.Small}" />
          <TextBlock Text="{Binding MyRoleName}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Создан" Style="{StaticResource Text.Small}" />
          <TextBlock Text="{Binding Project.CreatedAtUtc, Converter={StaticResource LocalDateTime}}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="3">
          <TextBlock Text="Изменён" Style="{StaticResource Text.Small}" />
          <TextBlock Text="{Binding Project.UpdatedAtUtc, Converter={StaticResource LocalDateTime}}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,12,0,0" Visibility="{Binding Project.Description, Converter={StaticResource NotNullToVisibility}}">
          <TextBlock Text="Описание" Style="{StaticResource Text.Small}" />
          <TextBlock Text="{Binding Project.Description}" Style="{StaticResource Text.Base}" />
        </StackPanel>
      </Grid>
    </Border>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Добавить участника" Style="{StaticResource Button.Primary}" Command="{Binding AddMemberCommand}"
              Visibility="{Binding CanManageMembers, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="Участники проекта" Style="{StaticResource Text.SectionTitle}" Margin="0" VerticalAlignment="Center" />
    </DockPanel>

    <Grid>
      <DataGrid ItemsSource="{Binding Members}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Участник" Binding="{Binding DisplayName}" Width="*" />
          <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="160" />
          <DataGridTextColumn Header="Роль в проекте" Binding="{Binding Role, Converter={StaticResource DisplayName}}" Width="190" />
          <DataGridTextColumn Header="Добавлен" Binding="{Binding AddedAtUtc, Converter={StaticResource LocalDateTime}}" Width="140" />
          <DataGridTemplateColumn Header="Действия" Width="190" Visibility="{Binding Data.CanManageMembers, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Изменить роль" Style="{StaticResource Button.RowAction}"
                          Command="{Binding DataContext.ChangeMemberRoleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                  <Button Content="Удалить" Style="{StaticResource Button.RowAction}" Foreground="{StaticResource Brush.Danger}"
                          Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="В проекте пока нет участников с явно назначенной ролью. Владельцы и администраторы организации имеют доступ ко всем проектам."
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" TextAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding MembersLoaded}" Value="True" />
                  <Condition Binding="{Binding Members.Count}" Value="0" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </DockPanel>
</UserControl>
