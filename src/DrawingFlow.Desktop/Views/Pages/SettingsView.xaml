<UserControl x:Class="DrawingFlow.Desktop.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrawingFlow.Desktop.ViewModels"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />

      <Border Style="{StaticResource Border.Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Учётная запись" Style="{StaticResource Text.SectionTitle}" />
          <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding UserLogin}" Style="{StaticResource Text.Muted}" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Сменить пароль" Style="{StaticResource Button.Secondary}" Command="{Binding ChangePasswordCommand}" />
            <Button Content="Выйти" Style="{StaticResource Button.Danger}" Margin="8,0,0,0" Command="{Binding LogoutCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Border.Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Сервер" Style="{StaticResource Text.SectionTitle}" />
          <TextBlock Text="{Binding ServerAddress}" Style="{StaticResource Text.Base}" />
          <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                     Text="Адрес сервера задаётся в окне входа. Для подключения к другому серверу выйдите из учётной записи." />
          <Button Content="Сменить сервер…" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding ChangeServerCommand}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Border.Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Сессия" Style="{StaticResource Text.SectionTitle}" />
          <CheckBox Content="Запоминать вход на этом компьютере" IsChecked="{Binding RememberSession}" />
          <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                     Text="Сессия хранится в зашифрованном виде (Windows DPAPI) и доступна только текущему пользователю Windows. При выключении сохранённая сессия удаляется." />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Border.Card}">
        <StackPanel>
          <TextBlock Text="О программе" Style="{StaticResource Text.SectionTitle}" />
          <TextBlock Style="{StaticResource Text.Base}">
            <Run Text="DrawingFlow Desktop, версия" /><Run Text=" " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0">
            <Run Text="Файл настроек:" /><Run Text=" " /><Run Text="{Binding SettingsPath, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource Text.Small}" Margin="0,2,0,0">
            <Run Text="Журнал приложения:" /><Run Text=" " /><Run Text="{Binding LogDirectory, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
