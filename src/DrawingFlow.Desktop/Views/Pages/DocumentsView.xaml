<UserControl x:Class="DrawingFlow.Desktop.Views.Pages.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrawingFlow.Desktop.ViewModels"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:DocumentsViewModel}">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Зарегистрировать документ" Style="{StaticResource Button.Primary}" VerticalAlignment="Top"
              Command="{Binding RegisterDocumentCommand}" Visibility="{Binding CanRegister, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" Margin="0" />
    </DockPanel>

    <Border DockPanel.Dock="Top" Style="{StaticResource Border.Card}" Padding="12" Margin="0,0,0,12">
      <StackPanel>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Проект:" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" MaxWidth="520" HorizontalAlignment="Left" MinWidth="320">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <Run Text="{Binding Code, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding Name, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <Grid IsEnabled="{Binding HasProject}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по номеру и наименованию документа">
            <TextBox.InputBindings>
              <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <ComboBox Grid.Column="1" Width="170" Margin="8,0,0,0" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" />
          <ComboBox Grid.Column="2" Width="170" Margin="8,0,0,0" ItemsSource="{Binding DisciplineOptions}" SelectedItem="{Binding SelectedDiscipline}" />
          <Button Grid.Column="3" Content="Найти" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
          <Button Grid.Column="4" Content="Сбросить" Style="{StaticResource Button.Link}" Margin="4,0,0,0" Command="{Binding ClearSearchCommand}" />
          <TextBlock Grid.Column="5" Text="{Binding SortIndicator}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
      </StackPanel>
    </Border>

    <ProgressBar DockPanel.Dock="Top" Style="{StaticResource ProgressBar.Thin}" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    <Border DockPanel.Dock="Top" Style="{StaticResource Border.ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Повторить" Style="{StaticResource Button.Link}" Command="{Binding RefreshCommand}" />
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Назад" Style="{StaticResource Button.Secondary}" Command="{Binding PreviousPageCommand}" />
        <Button Content="Вперёд" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding NextPageCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
    </DockPanel>

    <Grid>
      <DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" Sorting="OnSorting">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
            <Setter Property="Cursor" Value="Hand" />
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Номер" Binding="{Binding DocumentNumber}" Width="160" SortMemberPath="Number" />
          <DataGridTextColumn Header="Наименование" Binding="{Binding Title}" Width="*" SortMemberPath="Title" />
          <DataGridTextColumn Header="Раздел" Binding="{Binding Discipline}" Width="90" CanUserSort="False" />
          <DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource DisplayName}}" Width="140" SortMemberPath="Status" />
          <DataGridTextColumn Header="Версия" Binding="{Binding CurrentVersion.VersionNumber}" Width="70" CanUserSort="False" />
          <DataGridTextColumn Header="Файл" Binding="{Binding CurrentVersion.OriginalFileName}" Width="200" CanUserSort="False" />
          <DataGridTextColumn Header="Изменён" Binding="{Binding UpdatedAtUtc, Converter={StaticResource LocalDateTime}}" Width="140" SortMemberPath="UpdatedAt" />
          <DataGridTemplateColumn Width="90" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Открыть" Style="{StaticResource Button.RowAction}"
                        Command="{Binding DataContext.OpenSelectedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <Border Style="{StaticResource Border.Card}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32"
              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="Документы не найдены" Style="{StaticResource Text.SectionTitle}" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource Text.Muted}" TextAlignment="Center"
                     Text="Измените условия поиска или зарегистрируйте документ, если у вас есть права инженера или руководителя проекта." />
        </StackPanel>
      </Border>
      <TextBlock Text="В организации нет проектов. Сначала создайте проект." HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding LoadedOnce}" Value="True" />
                  <Condition Binding="{Binding HasProject}" Value="False" />
                  <Condition Binding="{Binding HasError}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </DockPanel>
</UserControl>
