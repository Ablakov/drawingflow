<UserControl x:Class="DrawingFlow.Desktop.Views.Pages.DocumentDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrawingFlow.Desktop.ViewModels"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:DocumentDetailsViewModel}">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="Загрузить новую версию" Style="{StaticResource Button.Primary}" Command="{Binding UploadVersionCommand}"
                Visibility="{Binding CanUpload, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="Изменить сведения" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding EditCommand}"
                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="{Binding ArchiveActionText}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding ToggleArchiveCommand}"
                Visibility="{Binding CanArchive, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="Обновить" Style="{StaticResource Button.Link}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
      </StackPanel>
      <StackPanel>
        <Button Content="← К реестру документов" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="-6,0,0,4" Command="{Binding BackCommand}" />
        <TextBlock Style="{StaticResource Text.PageTitle}" Margin="0">
          <Run Text="{Binding Document.DocumentNumber, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding Document.Title, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </DockPanel>

    <ProgressBar DockPanel.Dock="Top" Style="{StaticResource ProgressBar.Thin}" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    <Border DockPanel.Dock="Top" Style="{StaticResource Border.ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Повторить" Style="{StaticResource Button.Link}" Command="{Binding RefreshCommand}" />
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Style="{StaticResource Border.InfoBanner}" Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="{Binding TransferText}" Style="{StaticResource Text.Base}" />
        <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding TransferProgress, Mode=OneWay}" Foreground="{StaticResource Brush.Accent}" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource Border.Card}" Margin="0,0,0,12" Visibility="{Binding Document, Converter={StaticResource NotNullToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Статус" Style="{StaticResource Text.Small}" />
          <TextBlock Text="{Binding StatusName}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Раздел / тип" Style="{StaticResource Text.Small}" />
          <TextBlock FontWeight="SemiBold">
            <Run Text="{Binding Document.Discipline, Mode=OneWay, TargetNullValue='—'}" /><Run Text=" / " /><Run Text="{Binding Document.DocumentType, Mode=OneWay, TargetNullValue='—'}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Текущая версия" Style="{StaticResource Text.Small}" />
          <TextBlock FontWeight="SemiBold" Text="{Binding Document.CurrentVersion.VersionNumber, Mode=OneWay, TargetNullValue='нет'}" />
        </StackPanel>
        <StackPanel Grid.Column="3">
          <TextBlock Text="Зарегистрирован" Style="{StaticResource Text.Small}" />
          <TextBlock FontWeight="SemiBold">
            <Run Text="{Binding Document.CreatedAtUtc, Converter={StaticResource LocalDateTime}, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding Document.CreatedByName, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="Изменён" Style="{StaticResource Text.Small}" />
          <TextBlock Text="{Binding Document.UpdatedAtUtc, Converter={StaticResource LocalDateTime}}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0" Visibility="{Binding Document.Description, Converter={StaticResource NotNullToVisibility}}">
          <TextBlock Text="Описание" Style="{StaticResource Text.Small}" />
          <TextBlock Text="{Binding Document.Description}" Style="{StaticResource Text.Base}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Согласование -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Border.Card}" Margin="0,0,0,12" Visibility="{Binding Workflow, Converter={StaticResource NotNullToVisibility}}">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="Отправить на проверку" Style="{StaticResource Button.Primary}" Command="{Binding SubmitForReviewCommand}"
                    Visibility="{Binding CanSubmit, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Согласовать" Style="{StaticResource Button.Primary}" Command="{Binding ApproveCommand}"
                    Visibility="{Binding CanDecide, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Вернуть на доработку" Style="{StaticResource Button.Danger}" Margin="8,0,0,0" Command="{Binding RequestRevisionCommand}"
                    Visibility="{Binding CanDecide, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Выпустить" Style="{StaticResource Button.Primary}" Command="{Binding ReleaseCommand}"
                    Visibility="{Binding CanRelease, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Согласование" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Text.Muted}">
              <Run Text="Состояние документа:" /><Run Text=" " /><Run Text="{Binding StatusName, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
          </StackPanel>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding OpenTasks}" Margin="0,10,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource Brush.WarningLight}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Text.Base}">
                  <Run Text="{Binding Type, Converter={StaticResource DisplayName}, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " />
                  <Run Text="{Binding AssigneeName, Mode=OneWay}" /><Run Text=" · версия " /><Run Text="{Binding VersionNumber, Mode=OneWay}" />
                  <Run Text=" · поручил " /><Run Text="{Binding CreatedByName, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding CreatedAtUtc, Converter={StaticResource LocalDateTime}, Mode=OneWay}" />
                </TextBlock>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Решений по документу пока нет." Style="{StaticResource Text.Small}" Margin="0,6,0,0" Visibility="{Binding Reviews.Count, Converter={StaticResource ZeroToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Reviews}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,6">
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Base}">
                    <Run Text="{Binding Decision, Converter={StaticResource DisplayName}, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" · версия " /><Run Text="{Binding VersionNumber, Mode=OneWay}" />
                    <Run Text=" · " /><Run Text="{Binding ReviewerName, Mode=OneWay}" />
                    <Run Text=" · " /><Run Text="{Binding DecidedAtUtc, Converter={StaticResource LocalDateTime}, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Comment}" Style="{StaticResource Text.Muted}" Visibility="{Binding Comment, Converter={StaticResource NotNullToVisibility}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="История версий" Style="{StaticResource Text.SectionTitle}" />

    <Grid>
      <DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="№" Binding="{Binding VersionNumber}" Width="50" />
          <DataGridTemplateColumn Header="Файл" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding OriginalFileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Border Background="{StaticResource Brush.AccentLight}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                          Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="текущая" FontSize="11" Foreground="{StaticResource Brush.Accent}" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Размер" Binding="{Binding FileSize, Converter={StaticResource FileSize}}" Width="90" />
          <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256Hash, Converter={StaticResource ShortHash}}" Width="130">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="ToolTip" Value="{Binding Sha256Hash}" />
                <Setter Property="FontFamily" Value="Consolas" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Автор" Binding="{Binding CreatedByName}" Width="160" />
          <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAtUtc, Converter={StaticResource LocalDateTime}}" Width="130" />
          <DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource DisplayName}}" Width="130" />
          <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="200" />
          <DataGridTemplateColumn Header="Действия" Width="300">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Открыть" Style="{StaticResource Button.RowAction}"
                          Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                  <Button Content="Скачать…" Style="{StaticResource Button.RowAction}"
                          Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                  <Button Content="В папке" Style="{StaticResource Button.RowAction}" ToolTip="Показать локальную копию в Проводнике"
                          Command="{Binding DataContext.RevealInFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                  <Button Content="Сравнить с текущей" Style="{StaticResource Button.RowAction}"
                          Command="{Binding DataContext.CompareWithCurrentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                          Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="Версий пока нет. Загрузите первый файл документа." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" TextAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding VersionsLoaded}" Value="True" />
                  <Condition Binding="{Binding Versions.Count}" Value="0" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </DockPanel>
</UserControl>
