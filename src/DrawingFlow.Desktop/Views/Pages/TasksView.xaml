<UserControl x:Class="DrawingFlow.Desktop.Views.Pages.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrawingFlow.Desktop.ViewModels"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:TasksViewModel}">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Обновить" Style="{StaticResource Button.Secondary}" VerticalAlignment="Top" Command="{Binding RefreshCommand}" />
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" Margin="0" />
        <TextBlock Style="{StaticResource Text.Muted}" Visibility="{Binding Summary, Converter={StaticResource NotNullToVisibility}}">
          <Run Text="Мои согласования:" /><Run Text=" " /><Run Text="{Binding Summary.MyOpenReviews, Mode=OneWay}" />
          <Run Text=" · на доработку:" /><Run Text=" " /><Run Text="{Binding Summary.MyOpenReworks, Mode=OneWay}" />
          <Run Text=" · документов на проверке в моих проектах:" /><Run Text=" " /><Run Text="{Binding Summary.DocumentsInReview, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </DockPanel>

    <Border DockPanel.Dock="Top" Style="{StaticResource Border.Card}" Padding="12" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Показать:" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Width="220" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" />
        <Button Content="Применить" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding ApplyFilterCommand}" />
      </StackPanel>
    </Border>

    <ProgressBar DockPanel.Dock="Top" Style="{StaticResource ProgressBar.Thin}" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    <Border DockPanel.Dock="Top" Style="{StaticResource Border.ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Назад" Style="{StaticResource Button.Secondary}" Command="{Binding PreviousPageCommand}" />
        <Button Content="Вперёд" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding NextPageCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
    </DockPanel>

    <Grid>
      <DataGrid ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Задача" Binding="{Binding Type, Converter={StaticResource DisplayName}}" Width="150" />
          <DataGridTextColumn Header="Проект" Binding="{Binding ProjectCode}" Width="90" />
          <DataGridTextColumn Header="Документ" Binding="{Binding DocumentNumber}" Width="120" />
          <DataGridTextColumn Header="Наименование" Binding="{Binding DocumentTitle}" Width="*" />
          <DataGridTextColumn Header="Версия" Binding="{Binding VersionNumber}" Width="60" />
          <DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource DisplayName}}" Width="100" />
          <DataGridTextColumn Header="Срок" Binding="{Binding DueAtUtc, Converter={StaticResource LocalDateTime}, ConverterParameter='dd.MM.yyyy'}" Width="90" />
          <DataGridTextColumn Header="Поручил" Binding="{Binding CreatedByName}" Width="140" />
          <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="200" />
          <DataGridTemplateColumn Header="Действия" Width="320">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Документ" Style="{StaticResource Button.RowAction}"
                          Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                  <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding Type}" Value="Review" />
                              <Condition Binding="{Binding Status}" Value="Open" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <Button Content="Согласовать" Style="{StaticResource Button.RowAction}"
                            Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                    <Button Content="Вернуть" Style="{StaticResource Button.RowAction}" Foreground="{StaticResource Brush.Danger}"
                            Command="{Binding DataContext.RequestRevisionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                  </StackPanel>
                  <Button Content="Отменить"
                          Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Button.RowAction}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status}" Value="Open">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="Задач нет." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </DockPanel>
</UserControl>
